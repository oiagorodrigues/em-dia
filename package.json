{
  "name": "emdia",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun install && node scripts/setup.ts && bun run seed",
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run --parallel --filter @emdia/api --filter @emdia/web dev",
    "build": "vp run -r build",
    "start": "WEB_DIST_DIR=../web/dist bun run --cwd apps/api start",
    "build:vercel": "vp run --filter @emdia/api build && bun run --cwd apps/web vp build && bun run --cwd apps/api db:migrate --if-configured",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:generate": "bun run --cwd apps/api db:generate",
    "prepare": "vp config",
    "seed": "vp run --filter @emdia/api seed",
    "test": "vp run -r test",
    "check": "vp check",
    "docs:schema": "vp run --filter @emdia/harness docs:schema"
  },
  "devDependencies": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
