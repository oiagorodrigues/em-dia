{
  "name": "@emdia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "vp pack",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "test": "vp test",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts"
  },
  "dependencies": {
    "@emdia/shared": "workspace:*",
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "nodemailer": "10.0.15",
    "rate-limit-redis": "6.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  }
}
