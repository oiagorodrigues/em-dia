{
  "name": "@emdia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "vp pack",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "test": "vp test",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@emdia/shared": "workspace:*",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.11",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "nodemailer": "10.1.4",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "rate-limit-redis": "6.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0"
  }
}
