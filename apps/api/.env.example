# development | test | production
NODE_ENV=development
PORT=3000
# Unset: embedded PGlite (Postgres in WASM) in ./data/pglite, migrated at startup. Also pglite:<dir> or pglite:memory.
# postgres://… or postgresql://… (Neon, `docker compose`, any Postgres) uses node-postgres and is migrated only by
# `bun run db:migrate` (the Vercel build and the Docker entrypoint run it). With Neon use the pooled URL here.
DATABASE_URL=
# Migrations take a session advisory lock, which Neon's pooler does not keep. `db:migrate` uses this direct URL
# when set (the Neon integration provides it), otherwise DATABASE_URL with any `-pooler` host suffix removed.
DATABASE_URL_UNPOOLED=
# Receipts are written here, never served statically.
UPLOAD_DIR=./data/uploads
# With either set, receipts go to a private Vercel Blob store instead of UPLOAD_DIR. On Vercel,
# connecting the store to the project adds BLOB_STORE_ID (OIDC); BLOB_READ_WRITE_TOKEN works anywhere.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# HS256 key for access tokens and invite-code hashing. Required in production, at least 32 chars.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# When unset outside production a random key is generated per boot (sessions die on restart).
JWT_SECRET=
# The only origin allowed by CORS (credentials on). Also used to build password reset links.
WEB_ORIGIN=http://localhost:5173
# Express "trust proxy": false | true | hop count (1) | comma-separated subnets/presets (loopback)
TRUST_PROXY=false
# debug | info | warn | error | silent
LOG_LEVEL=info
# Requests per IP per 15 minutes: everything / login, register, forgot and reset password
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
# Shared rate-limit counters in Upstash Redis (REST). Without them counters live in each process,
# which on Vercel means per function instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A refresh token rotated less than this many ms ago may be replayed once more (lost response, two tabs)
# without being treated as theft. 0 disables the grace window.
REFRESH_REUSE_GRACE_MS=20000
# Built web app to serve from the same origin (e.g. ../web/dist after `bun run build`).
# Leave empty when the web app is hosted elsewhere or served by the Vite dev server.
WEB_DIST_DIR=
# Outgoing mail (invites, password resets). smtp:// or smtps:// with credentials, e.g.
# smtps://user:password@smtp.example.com:465. Unset: development keeps mail in GET /api/v1/dev/outbox;
# production drops it with a warning and invites report emailSent=false.
SMTP_URL=
MAIL_FROM=em dia <nao-responda@localhost>
# Set by Vercel itself (VERCEL=1, VERCEL_PROJECT_PRODUCTION_URL). On Vercel the API requires a postgres://
# DATABASE_URL and a Blob store, defaults TRUST_PROXY to 1, WEB_ORIGIN to https://$VERCEL_PROJECT_PRODUCTION_URL
# and caps receipts at 4 MB (functions reject bodies over 4.5 MB). Also set NODEJS_HELPERS=0 there.
